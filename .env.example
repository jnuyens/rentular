# ===========================================
# Rentular - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ----- Database -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rentular
DB_USER=rentular
DB_PASSWORD=rentular

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Auth (NextAuth.js) -----
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Google OAuth
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth
# https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Twitter/X OAuth
# https://developer.twitter.com/en/portal/dashboard
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ----- GoCardless -----
# https://manage.gocardless.com/developers
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# ----- API -----
API_PORT=4000
API_URL=http://localhost:4000

# ----- Web -----
WEB_URL=http://localhost:3000
# Comma-separated list of allowed origins for CSRF and CORS (defaults to WEB_URL)
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Canonical public site URL for SEO (sitemap.xml, robots.txt, canonical/OG tags).
# Falls back to WEB_URL, then https://www.rentular.com. Set to the production
# host in prod, e.g. https://www.rentular.com
NEXT_PUBLIC_SITE_URL=

# ----- Email (Mailpit for development) -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rentular.com

# Admin notification email (receives alerts for new user signups)
ADMIN_EMAIL=

# ----- Bank Data Provider (PSD2 / Open Banking) -----
# Provider selection: ponto | gocardless_bad
BANK_DATA_PROVIDER=ponto
# Redirect URL registered with the chosen provider (HTTPS in production)
BANK_CONNECTION_REDIRECT_URL=http://localhost:4000/api/v1/bank-connections/callback

# ----- Ponto Connect (Ibanity) -----
# https://documentation.ibanity.com/ponto-connect/api
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_ENVIRONMENT=sandbox
# Optional override; defaults to BANK_CONNECTION_REDIRECT_URL
PONTO_REDIRECT_URI=
# mTLS transport certificate — REQUIRED for every api.ibanity.com call (sandbox
# AND production; without it the TLS handshake fails "certificate required").
# In production POST requests must ALSO be signed with a separate SIGNATURE
# certificate (see PONTO_*_SIG_* below). Provide filesystem paths (store outside
# the repo, chmod 600) or inline PEM. Use PONTO_TLS_PFX instead of CERT+KEY for
# a PKCS#12 bundle.
PONTO_TLS_CERT=
PONTO_TLS_KEY=
PONTO_TLS_PASSPHRASE=
PONTO_TLS_PFX=

# --- Production: two applications (PPM = individuals billed via Rentular, CPM =
# companies pay Isabel directly). Each has its own credentials + transport cert
# + signature cert. If these are unset, the single-app PONTO_* vars above are
# used for both (sandbox). SIG_KEY is the signature private key (path or inline
# PEM); SIG_KEY_ID is that certificate's UUID from the Ibanity portal.
PONTO_PPM_CLIENT_ID=
PONTO_PPM_CLIENT_SECRET=
PONTO_PPM_TLS_CERT=
PONTO_PPM_TLS_KEY=
PONTO_PPM_TLS_PASSPHRASE=
PONTO_PPM_TLS_PFX=
PONTO_PPM_SIG_KEY=
PONTO_PPM_SIG_KEY_ID=
PONTO_PPM_SIG_PASSPHRASE=
PONTO_CPM_CLIENT_ID=
PONTO_CPM_CLIENT_SECRET=
PONTO_CPM_TLS_CERT=
PONTO_CPM_TLS_KEY=
PONTO_CPM_TLS_PASSPHRASE=
PONTO_CPM_TLS_PFX=
PONTO_CPM_SIG_KEY=
PONTO_CPM_SIG_KEY_ID=
PONTO_CPM_SIG_PASSPHRASE=

# ----- GoCardless Bank Account Data (legacy / dormant reference) -----
# https://bankaccountdata.gocardless.com/
GOCARDLESS_BAD_SECRET_ID=
GOCARDLESS_BAD_SECRET_KEY=

# ----- Bank Statement Retention (Belgian tax law) -----
# Default 2555 days = 7 years (configurable in Plan 05 retention cron)
BANK_STATEMENTS_RETENTION_DAYS=2555
