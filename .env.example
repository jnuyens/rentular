# ===========================================================================
# Rentular: environment for local development
# ===========================================================================
# cp .env.example .env, then fill in what you need.
#
# Neither the API nor the dev scripts load this file by themselves. Export it
# into your shell before starting anything:
#   set -a; . ./.env; set +a
#   pnpm dev
# Keep values free of spaces and <> so the file stays shell-sourceable.
#
# [required] means the app refuses to start or a core feature breaks without
# it. Everything else is optional and has a sensible default or turns a
# feature off when empty. For a production setup see .env.production.example
# and SELF-HOSTING.md.
# ===========================================================================

# ----- Core URLs and secrets -----
# [required] Signs sessions and OAuth state, and is the key that encrypts
# stored secrets (bank tokens, per-landlord SMTP passwords). At least 16
# characters. Generate with: openssl rand -base64 32
# Never change it on an install with data: encrypted values become unreadable.
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the web app. Used for links in emails and as the NextAuth URL.
AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3000
# Origins allowed by CORS and CSRF on the API, comma-separated (default WEB_URL).
ALLOWED_ORIGINS=http://localhost:3000
# [required] Where the browser reaches the API. Baked into the web bundle at
# build time, so rebuild the web app after changing it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Canonical public URL for sitemap.xml, robots.txt and canonical tags.
# Falls back to WEB_URL, then https://www.rentular.com.
NEXT_PUBLIC_SITE_URL=
# Port the API listens on (default 4000).
API_PORT=4000

# ----- Database (MySQL 8 or MariaDB 10.6+) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rentular
DB_USER=rentular
# [required] The API, the web app and drizzle-kit all refuse to run without it.
DB_PASSWORD=rentular
# Only used by docker-compose.yml for the MariaDB root account.
# DB_ROOT_PASSWORD=rootpassword

# ----- Redis (BullMQ queues, rate limits) -----
# [required] Redis must be running. The health check and token rate limiter
# use REDIS_URL, the background workers use REDIS_HOST and REDIS_PORT. Point
# both at the same server.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- Sign-in with Google, Facebook, X (optional) -----
# Each provider shows up on the login page only when both its values are set.
# Callback URL to register: <WEB_URL>/api/auth/callback/<google|facebook|twitter>
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# https://developer.twitter.com/en/portal/dashboard
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ----- Admin account and notifications -----
# Receives new-signup alerts and replies to unknown reply addresses. Also the
# email of the first owner account created by the bootstrap script.
ADMIN_EMAIL=
# Only read by the bootstrap script (pnpm --filter @rentular/api bootstrap).
# Remove it from the file once the first owner exists.
ADMIN_PASSWORD=
# Where the in-app support form sends its email. Empty = support email off.
SUPPORT_EMAIL=

# ----- Email (Mailpit in development) -----
# Platform SMTP relay. Landlords can also set their own SMTP in Settings.
SMTP_HOST=localhost
SMTP_PORT=1025
# Set both for an authenticated relay. Without them the relay is treated as a
# trusted local one (certificate checks relaxed, no AUTH).
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS. When empty, port 465 means TLS and other ports use
# STARTTLS when the server offers it.
SMTP_SECURE=
# Sender address and display name. A full "Name <address>" in EMAIL_FROM is
# used as-is, but then the file is no longer shell-sourceable, so prefer the
# two separate values.
EMAIL_FROM=noreply@example.org
EMAIL_FROM_NAME=Rentular
# Max emails per minute through the queue (default 30).
EMAIL_RATE_LIMIT=30
# true = rent reminders go to the landlord with "TEST PHASE MAIL" in the
# subject instead of to the tenant, and SMS is skipped. Handy while you check
# your setup. Default off.
PAYMENT_EMAIL_TEST_PHASE=

# ----- Tenant replies through reply+<token>@ addresses (optional) -----
# With INBOUND_REPLY_SECRET set, every tenant email about a contract gets
# Reply-To: reply+<token>@INBOUND_REPLY_DOMAIN. Empty = plain mail, no reply
# address. See infra/cloudflare/inbound-email/README.md.
INBOUND_REPLY_SECRET=
INBOUND_REPLY_DOMAIN=example.org
# Shared secret sent in the X-Inbound-Secret header by your inbound mail
# route. POST /api/v1/inbound/email answers 404 while this is empty.
INBOUND_WEBHOOK_SECRET=
# Where replies to an unknown or revoked reply address go (default ADMIN_EMAIL).
INBOUND_FALLBACK_TO=
# Calls per minute per client address on the inbound endpoint (default 120).
INBOUND_RATE_LIMIT=

# ----- SMS (optional) -----
# twilio | messagebird | ovh | smsgateway | console (default console: only logs)
SMS_PROVIDER=console
# Max SMS per minute through the queue (default 10).
SMS_RATE_LIMIT=10
# Text put in front of every SMS (default "[Rentular] ").
# SMS_SENDER_PREFIX=
# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# messagebird
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=
# ovh
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
OVH_SMS_SENDER=
# smsgateway: a self-hosted gateway, for example an Android phone with a SIM
# running an SMS gateway app. Use basic auth or an API key.
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_API_KEY=
# Header that carries the API key (default Authorization) and an optional
# prefix such as "Bearer ".
SMS_GATEWAY_API_KEY_HEADER=
SMS_GATEWAY_API_KEY_PREFIX=
# Sender number, for body templates that need one.
SMS_GATEWAY_FROM=
# JSON body with {{message}}, {{to}} and {{from}} placeholders. The default
# fits sms-gate.app: {"message":{{message}},"phoneNumbers":[{{to}}]}
SMS_GATEWAY_BODY_TEMPLATE=
SMS_GATEWAY_TIMEOUT_MS=15000

# ----- WhatsApp through a self-hosted bridge (optional) -----
# Both set = WhatsApp sending is on. Empty = no WhatsApp.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
# Line appended to every WhatsApp text, for example a name.
WHATSAPP_SIGNATURE=
WHATSAPP_TIMEOUT_MS=20000

# ----- Signal for the support form (optional) -----
# A signal-cli REST API endpoint, e.g. http://localhost:8080/v2/send
SIGNAL_BOT_URL=
SIGNAL_BOT_NUMBER=
SIGNAL_SUPPORT_NUMBER=

# ----- GoCardless SEPA direct debit (optional) -----
# https://manage.gocardless.com/developers
GOCARDLESS_ACCESS_TOKEN=
# sandbox | live
GOCARDLESS_ENVIRONMENT=sandbox
# Webhook endpoint: <API>/api/v1/webhooks/gocardless
GOCARDLESS_WEBHOOK_SECRET=

# ----- Stripe, for selling subscriptions (optional) -----
# Only needed if you charge your own users. Rent collection never uses Stripe.
STRIPE_SECRET_KEY=
# Webhook endpoint: <API>/api/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PROFESSIONAL=

# ----- Bank connections (PSD2, optional) -----
# ponto | gocardless_bad
BANK_DATA_PROVIDER=ponto
# Redirect URL registered with the provider (HTTPS in production).
BANK_CONNECTION_REDIRECT_URL=http://localhost:4000/api/v1/bank-connections/callback
# Bank statements older than this are deleted (default 2555 days, 7 years).
BANK_STATEMENTS_RETENTION_DAYS=2555

# ----- Ponto Connect (Ibanity) -----
# https://documentation.ibanity.com/ponto-connect/api
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
# sandbox | production
PONTO_ENVIRONMENT=sandbox
# Optional, defaults to BANK_CONNECTION_REDIRECT_URL.
PONTO_REDIRECT_URI=
# Every api.ibanity.com call needs an mTLS transport certificate, sandbox too.
# Give file paths (outside the repo, chmod 600) or inline PEM. PONTO_TLS_PFX
# replaces CERT+KEY for a PKCS#12 bundle.
PONTO_TLS_CERT=
PONTO_TLS_KEY=
PONTO_TLS_PASSPHRASE=
PONTO_TLS_PFX=
# Signature certificate, needed in production for signed POST requests.
# SIG_KEY is the private key (path or PEM), SIG_KEY_ID the certificate UUID
# from the Ibanity portal.
PONTO_SIG_KEY=
PONTO_SIG_KEY_ID=
PONTO_SIG_PASSPHRASE=
# Customer IP sent to Ponto when a background sync asks the bank for new
# transactions (PSD2 wants one). Without it, background syncs only read what
# Ponto already fetched.
PONTO_SYNC_IP=
# Production can use two Ponto applications: PPM (individuals billed via you)
# and CPM (companies that pay Isabel directly). Every PONTO_* value above also
# exists as PONTO_PPM_* and PONTO_CPM_*; when one is empty the plain PONTO_*
# value is used. A single application only needs the plain values.
# PONTO_PPM_CLIENT_ID=
# PONTO_PPM_CLIENT_SECRET=
# PONTO_PPM_TLS_CERT=
# PONTO_PPM_TLS_KEY=
# PONTO_PPM_TLS_PASSPHRASE=
# PONTO_PPM_TLS_PFX=
# PONTO_PPM_SIG_KEY=
# PONTO_PPM_SIG_KEY_ID=
# PONTO_PPM_SIG_PASSPHRASE=
# PONTO_CPM_CLIENT_ID=
# PONTO_CPM_CLIENT_SECRET=
# PONTO_CPM_TLS_CERT=
# PONTO_CPM_TLS_KEY=
# PONTO_CPM_TLS_PASSPHRASE=
# PONTO_CPM_TLS_PFX=
# PONTO_CPM_SIG_KEY=
# PONTO_CPM_SIG_KEY_ID=
# PONTO_CPM_SIG_PASSPHRASE=

# ----- GoCardless Bank Account Data (legacy, not in use) -----
GOCARDLESS_BAD_SECRET_ID=
GOCARDLESS_BAD_SECRET_KEY=

# ----- Time zone -----
# Fallback zone for scheduled jobs when neither the monitored bank account nor
# the landlord has one (default Europe/Brussels).
APP_TIMEZONE=Europe/Brussels
# Zone for dates shown in the web app (build time, default Europe/Brussels).
NEXT_PUBLIC_APP_TIMEZONE=Europe/Brussels

# ----- Personal Access Tokens and MCP -----
# [required for API tokens] Pepper mixed into the hash of rtl_ tokens, at
# least 16 characters. Changing it invalidates every existing token.
API_TOKEN_PEPPER=
# Max requests per token per minute (default 120).
API_TOKEN_RATE_LIMIT_PER_MINUTE=120
# The MCP server (apps/mcp-server) reads RENTULAR_API_URL, RENTULAR_PAT and
# RENTULAR_TIMEOUT_MS from the environment Claude starts it with, not from
# this file. See apps/mcp-server/README.md.

# ----- Developer tools -----
# Only used by apps/api/src/services/spikeTest.ts (Smovin login probe).
# SMOVIN_EMAIL=
# SMOVIN_PASSWORD=
