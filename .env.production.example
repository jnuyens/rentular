# ===========================================================================
# Rentular: production environment template
# ===========================================================================
# Copy this to a file outside the repo or at least outside the web root, for
# example /opt/rentular/.env, then:
#   chmod 600 /opt/rentular/.env
# Replace every CHANGE_ME value and rent.example.org with your own domain.
# Generate secrets with: openssl rand -base64 32
#
# How the file reaches the app depends on the route you pick (SELF-HOSTING.md):
#   - docker-compose.prod.yml loads it with env_file (RENTULAR_ENV_FILE) and
#     needs --env-file pointing at it for the build and DB variables.
#   - With PM2, the ecosystem file reads it and passes it to both processes.
# Neither the API nor the web app reads a .env on its own.
#
# Keep values free of spaces and <> so `set -a; . ./.env` keeps working.
# Never commit the filled-in copy. The full list of variables, with the
# optional channels, is in .env.example.
# ===========================================================================

# ----- Core URLs and secrets -----
# [required] Session signing, OAuth state and the encryption key for stored
# bank tokens and SMTP passwords. Set it once and keep it. Changing it later
# makes every encrypted value unreadable.
AUTH_SECRET=CHANGE_ME_generate_with_openssl
AUTH_URL=https://rent.example.org
WEB_URL=https://rent.example.org
ALLOWED_ORIGINS=https://rent.example.org
# [required] Baked into the web bundle at build time (a compose build arg too).
NEXT_PUBLIC_API_URL=https://rent.example.org/api/v1
NEXT_PUBLIC_SITE_URL=https://rent.example.org
API_PORT=4000

# ----- Database -----
# Compose: the api container gets DB_HOST=mariadb from the compose file, so
# 127.0.0.1 here is what the host-side bootstrap uses. PM2: the host database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rentular
DB_USER=rentular
# [required]
DB_PASSWORD=CHANGE_ME_generate_with_openssl
# Compose only: root password of the bundled MariaDB container.
DB_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl

# ----- Redis -----
# [required] Compose overrides these with the redis service. PM2: your Redis.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ----- Sign-in providers (optional) -----
# Callback URL: https://rent.example.org/api/auth/callback/<google|facebook|twitter>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ----- First owner and admin mail -----
ADMIN_EMAIL=you@example.org
# Only for the one-time bootstrap. Delete it from this file afterwards.
ADMIN_PASSWORD=CHANGE_ME_first_owner_password
SUPPORT_EMAIL=

# ----- Email -----
# Compose with the bundled Mailpit (mail is captured, not delivered):
#   SMTP_HOST=mailpit, SMTP_PORT=1025, leave SMTP_USER empty.
# A real relay, for example your provider on port 587 with STARTTLS:
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
# true for implicit TLS (port 465). Empty: 465 means TLS, others STARTTLS.
SMTP_SECURE=
EMAIL_FROM=noreply@rent.example.org
EMAIL_FROM_NAME=Rentular
EMAIL_RATE_LIMIT=30
# true while you test: reminders go to you instead of the tenant.
PAYMENT_EMAIL_TEST_PHASE=

# ----- Tenant replies (optional, see SELF-HOSTING.md) -----
INBOUND_REPLY_SECRET=
INBOUND_REPLY_DOMAIN=rent.example.org
INBOUND_WEBHOOK_SECRET=
INBOUND_FALLBACK_TO=

# ----- SMS, WhatsApp, Signal (optional, see .env.example) -----
SMS_PROVIDER=console
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
SIGNAL_BOT_URL=
SIGNAL_BOT_NUMBER=
SIGNAL_SUPPORT_NUMBER=

# ----- GoCardless SEPA direct debit (optional) -----
# Webhook: https://rent.example.org/api/v1/webhooks/gocardless
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=

# ----- Stripe subscriptions (optional, only to bill your own users) -----
# Webhook: https://rent.example.org/api/v1/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PROFESSIONAL=

# ----- Install kind and Enable Banking (optional) -----
# "self" here; rentular.com runs with "hosted". Self-hosted landlords can
# connect their bank through their own Enable Banking app for free.
RENTULAR_INSTANCE=self
# Only for a single-landlord install; otherwise each landlord uploads their
# own app in Bank connections. Key file outside the repo, chmod 600.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=

# ----- Bank connections through Ponto (optional) -----
BANK_DATA_PROVIDER=ponto
BANK_CONNECTION_REDIRECT_URL=https://rent.example.org/api/v1/bank-connections/callback
BANK_STATEMENTS_RETENTION_DAYS=2555
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_ENVIRONMENT=sandbox
PONTO_REDIRECT_URI=
# mTLS transport certificate (paths outside the repo, chmod 600, or inline PEM).
PONTO_TLS_CERT=
PONTO_TLS_KEY=
PONTO_TLS_PASSPHRASE=
PONTO_TLS_PFX=
# Production only: request signing certificate.
PONTO_SIG_KEY=
PONTO_SIG_KEY_ID=
PONTO_SIG_PASSPHRASE=
PONTO_SYNC_IP=
# Two applications (PPM/CPM): see .env.example for the PONTO_PPM_* and
# PONTO_CPM_* variants.

# ----- Time zone -----
APP_TIMEZONE=Europe/Brussels
NEXT_PUBLIC_APP_TIMEZONE=Europe/Brussels

# ----- Personal Access Tokens (needed for the MCP server and API scripts) -----
API_TOKEN_PEPPER=CHANGE_ME_generate_with_openssl
API_TOKEN_RATE_LIMIT_PER_MINUTE=120

# ----- Deploy webhook (only with deploy/webhook-receiver.mjs) -----
# DEPLOY_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl
