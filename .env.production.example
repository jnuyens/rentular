# ===========================================================================
# Rentular — PRODUCTION environment template (m1 / Hetzner)
# ===========================================================================
# This is the TEMPLATE for the root-owned secrets file on m1:
#     /opt/rentular/.env   (chown root:root, chmod 600, git-ignored)
#
# docker-compose.prod.yml injects this file into the `api` and `web`
# containers via `env_file:`. The API does NOT read a .env itself — compose
# places these vars into the container environment (D-03/D-10).
#
# HOW TO USE (on m1, as root):
#   cp .env.production.example /opt/rentular/.env
#   chmod 600 /opt/rentular/.env
#   # fill in every CHANGE_ME_* value, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# ROTATION (D-04): edit /opt/rentular/.env, then re-run `up -d`. The file must
# stay root-owned and chmod 600 — it holds the full ~37-key secret surface.
# NEVER commit real secret values; this template ships CHANGE_ME placeholders.
# Generate secrets with: openssl rand -base64 32
# ===========================================================================

# ----- Database -----
# DB_HOST=mariadb is the value the CONTAINERS use (compose service DNS).
# The host-shell bootstrap in deploy.sh (Plan 05) overrides DB_HOST=127.0.0.1
# for its own connection to the loopback-published MariaDB.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=rentular
DB_USER=rentular
# No default password in prod compose — this value is required.
DB_PASSWORD=CHANGE_ME_generate_with_openssl
# MariaDB root password (used by the mariadb container + first-run bootstrap).
DB_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- Auth (NextAuth.js) -----
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl
AUTH_URL=https://rentular.com

# Google OAuth
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth
# https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Twitter/X OAuth
# https://developer.twitter.com/en/portal/dashboard
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ----- GoCardless (SEPA rent collection) -----
# https://manage.gocardless.com/developers
# Prod launches on the GoCardless SANDBOX (production mTLS/live is out of scope).
GOCARDLESS_ACCESS_TOKEN=CHANGE_ME_gocardless_sandbox_token
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl

# ----- API -----
API_PORT=4000
API_URL=https://rentular.com/api/v1

# ----- Web -----
WEB_URL=https://rentular.com
# Comma-separated list of allowed origins for CSRF and CORS.
ALLOWED_ORIGINS=https://rentular.com
# NOTE: NEXT_PUBLIC_API_URL is ALSO required as a compose build.arg — it is
# baked into the browser bundle at build time. Keep this value in sync with
# the build arg (they must match).
NEXT_PUBLIC_API_URL=https://rentular.com/api/v1

# ----- Email (Mailpit on m1 for pre-release capture — D-01) -----
# SMTP_HOST=mailpit / SMTP_PORT=1025 point at the compose Mailpit service.
# Outgoing rent reminders + bank-connection renewal warnings are captured
# (not delivered) and inspected in the Mailpit UI (127.0.0.1:8025 via SSH
# tunnel). Switch to a real transactional provider later = edit these + restart
# (D-02), no code change.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rentular.com

# Admin notification email (receives alerts for new user signups).
ADMIN_EMAIL=admin@rentular.com
# First-run bootstrap owner password (drizzle-kit push + owner seed — D-08).
ADMIN_PASSWORD=CHANGE_ME_bootstrap_owner_password

# ----- Deploy webhook (git-push -> GitHub webhook -> deploy.sh — D-07) -----
# Shared secret the on-box webhook receiver verifies before running deploy.sh
# (mirrors modulejail's deploy-webhook.php). Used by Plan 05.
DEPLOY_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl

# ----- Bank Data Provider (PSD2 / Open Banking) -----
# Provider selection: ponto | gocardless_bad
BANK_DATA_PROVIDER=ponto
# Redirect URL registered with the chosen provider (HTTPS in production).
BANK_CONNECTION_REDIRECT_URL=https://rentular.com/api/v1/bank-connections/callback

# ----- Ponto Connect (Ibanity) -----
# https://documentation.ibanity.com/ponto-connect/api
# Prod launches on the Ponto SANDBOX (Basic auth); production mTLS +
# request-signing is out of scope for this phase.
PONTO_CLIENT_ID=CHANGE_ME_ponto_sandbox_client_id
PONTO_CLIENT_SECRET=CHANGE_ME_ponto_sandbox_client_secret
PONTO_ENVIRONMENT=sandbox
# Optional override; defaults to BANK_CONNECTION_REDIRECT_URL
PONTO_REDIRECT_URI=

# ----- GoCardless Bank Account Data (legacy / dormant reference) -----
# https://bankaccountdata.gocardless.com/
GOCARDLESS_BAD_SECRET_ID=
GOCARDLESS_BAD_SECRET_KEY=

# ----- Bank Statement Retention (Belgian tax law) -----
# Default 2555 days = 7 years.
BANK_STATEMENTS_RETENTION_DAYS=2555
