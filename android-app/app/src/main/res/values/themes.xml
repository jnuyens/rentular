<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Rentular" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryDark">@color/brand_navy</item>
        <item name="colorAccent">@color/brand_green</item>
        <item name="colorControlActivated">@color/brand_green</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Shown while the app starts, before the first layout is drawn. -->
        <item name="android:windowBackground">@drawable/bg_brand_gradient</item>
    </style>

    <style name="Theme.Rentular" parent="Base.Theme.Rentular" />

    <!-- Green call-to-action button with navy text, as on the website. -->
    <style name="Widget.Rentular.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary_green</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary text button. -->
    <style name="Widget.Rentular.Button.Text" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/brand_royal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- White rounded card that holds the native screen content. -->
    <style name="Widget.Rentular.Card" parent="">
        <item name="android:background">@drawable/card_rounded</item>
        <item name="android:elevation">6dp</item>
        <item name="android:padding">24dp</item>
    </style>
</resources>
