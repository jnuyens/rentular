<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon to change the Rentular server. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="change_server"
        android:shortcutLongLabel="@string/shortcut_change_server_long"
        android:shortcutShortLabel="@string/shortcut_change_server_short">
        <intent
            android:action="com.rentular.app.CHANGE_SERVER"
            android:targetClass="com.rentular.app.ServerSetupActivity"
            android:targetPackage="com.rentular.app" />
    </shortcut>
</shortcuts>
